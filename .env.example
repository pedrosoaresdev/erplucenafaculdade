# Copie para .env e preencha. NUNCA versione o arquivo .env.
#
# Gere as chaves (Linux/macOS/Git Bash):
#   openssl rand -base64 48   -> ERP_JWT_SECRET
#   openssl rand -base64 32   -> ERP_ENCRYPTION_KEY  (exatamente 32 bytes; guarde em local seguro)
# No Windows (PowerShell):
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))   -> ERP_JWT_SECRET
#   [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))   -> ERP_ENCRYPTION_KEY

ERP_DB_PASSWORD=troque-esta-senha-do-banco
ERP_JWT_SECRET=
ERP_ENCRYPTION_KEY=

# Dono da plataforma: único e-mail que pode criar o primeiro administrador Master pelo navegador.
# Ao subir, o servidor mostra no console um CÓDIGO DE INSTALAÇÃO de uso único.
ERP_OWNER_EMAIL=pedrolucenasoaresdev@gmail.com

# true quando publicado com HTTPS
ERP_COOKIE_SECURE=false
